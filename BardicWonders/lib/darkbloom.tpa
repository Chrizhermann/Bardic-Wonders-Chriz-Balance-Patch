     ~%MOD_FOLDER%/darkbloom/BGEE/SPPR427C.BAM~ ~override/C0BDDS4C.BAM~
     ~%MOD_FOLDER%/darkbloom/BGEE/tsprayt.BAM~ ~override/C0BDDA4.BAM~
COPY ~%MOD_FOLDER%/darkbloom/BGEE/IDPRO303.PRO~ ~override/C0BDDP4.PRO~
  LPF C0_BW_REPLACE_RESREF INT_VAR offset = 0x230
    STR_VAR expected = ~TSPRAYT~ resref = ~C0BDDA4~ label = ~Thorn Spray projectile~ END
ADD_PROJECTILE ~override/C0BDDP4.PRO~ ~Darkbloom Thorn Spray~
