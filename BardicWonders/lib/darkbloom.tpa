END
ACTION_IF NOT imported BEGIN
COPY ~%MOD_FOLDER%/darkbloom/BGEE/SPPR736B.BAM~ ~override/C0BDDS7B.BAM~
     ~%MOD_FOLDER%/darkbloom/BGEE/SPPR736C.BAM~ ~override/C0BDDS7C.BAM~
COPY ~%MOD_FOLDER%/darkbloom/BGEE/IDPRO307.PRO~ ~override/C0BDDP7.PRO~
ADD_PROJECTILE ~override/C0BDDP7.PRO~ ~Darkbloom Mist of Eldath~
COPY ~%MOD_FOLDER%/darkbloom/BGEE/SPPR736.SPL~ ~override/C0BDDS7.SPL~
  LPF C0_BW_SPL_PRIVATE_FALLBACK
    INT_VAR spell_type = 1 spell_level = 7 projectile = C0BDDP7
    STR_VAR identity = ~SPPR736~ destination = ~C0BDDS7~ label = ~Mist of Eldath~
  END
SAY NAME1 ~Mist of Eldath~
SAY UNIDENTIFIED_DESC ~Mist of Eldath
(Invocation)

Level: 7
Sphere: Elemental
Range: Visual range of the caster
Duration: Instant
Casting Time: 9
Area of Effect: 7-ft. radius
Saving Throw: None

This spell blankets the area of effect with a silver-blue mist—any creature within the mist will be cured of disease and poison and healed 25 Hit Points.~
END

// Name the granted spells in the kit description: Spell Revisions renames
// some of them, and every game language has its own names.
ACTION_DEFINE_ARRAY c0_bdd_kit_spells BEGIN C0BDDS1 C0BDDS2 C0BDDS3 C0BDDS4 C0BDDS5 C0BDDS6 C0BDDS7 END
LAF C0_BW_NAME_KIT_SPELLS INT_VAR description = c0_bdd_help STR_VAR spells = c0_bdd_kit_spells END
