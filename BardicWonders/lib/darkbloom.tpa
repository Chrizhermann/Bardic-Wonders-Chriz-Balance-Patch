LAF C0_BW_IMPORT_PRIEST_SPELL
  INT_VAR spell_type = 1 spell_level = 7 required = 0
  STR_VAR symbol = ~CLERIC_MIST_OF_ELDATH~ destination = ~C0BDDS7~ label = ~Mist of Eldath~
