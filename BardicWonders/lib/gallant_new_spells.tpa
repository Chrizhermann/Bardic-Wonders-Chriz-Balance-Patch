// New Bard Spells (component 2008) for the Gallant Paladin kit (component 1012).
//
// Either component may be installed first. Whichever is installed second
// calls this function: it copies the bard spells as Gallant priest spells,
// grants them through C0GALL3 at level 1 and fills the kit description's
// <BARDIC_SPELLS> placeholder. That component's WeiDU backup undoes all of it
// on uninstall, and a reinstall repeats the same check.
DEFINE_ACTION_FUNCTION C0_BW_GALLANT_NEW_SPELLS
BEGIN

COPY_EXISTING ~C0BW101.SPL~ ~OVERRIDE/C0GA101.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW102.SPL~ ~OVERRIDE/C0GA102.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW103.SPL~ ~OVERRIDE/C0GA103.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW201.SPL~ ~OVERRIDE/C0GA201.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW202.SPL~ ~OVERRIDE/C0GA202.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW203.SPL~ ~OVERRIDE/C0GA203.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW301.SPL~ ~OVERRIDE/C0GA301.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW302.SPL~ ~OVERRIDE/C0GA302.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW401.SPL~ ~OVERRIDE/C0GA401.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW402.SPL~ ~OVERRIDE/C0GA402.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW403.SPL~ ~OVERRIDE/C0GA403.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW501.SPL~ ~OVERRIDE/C0GA501.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW502.SPL~ ~OVERRIDE/C0GA502.SPL~
WRITE_SHORT 0X1C 2
COPY_EXISTING ~C0BW601.SPL~ ~OVERRIDE/C0GA601.SPL~
WRITE_SHORT 0X1C 2
  
COPY_EXISTING ~C0GALLAN.2DA~ ~OVERRIDE~
  // Grant C0GALL3 (the copies below) at level 1, once.
  PATCH_IF (INDEX_BUFFER (~\bAP_C0GALL3\b~) < 0) BEGIN
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_MaxLevel = 1 STR_VAR f_Entry = AP_C0GALL3 END
  END
BUT_ONLY

ACTION_FOR_EACH description IN 
    CLASTEXT
  BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%description%.2da~ BEGIN
      COPY_EXISTING ~%description%.2DA~ ~override~
      COUNT_2DA_COLS col_count
      COUNT_2DA_ROWS col_count rows
      FOR (index = 0; index < rows; ++index) BEGIN
        READ_2DA_ENTRY index 0 col_count row_name
        READ_2DA_ENTRY index 1 col_count class_id
//inspiration
        PATCH_IF "%row_name%" STRING_EQUAL_CASE "C0_GALLANT" BEGIN
          READ_2DA_ENTRY index 4 col_count kit_desc
          SPRINT old_desc ~<BARDIC_SPELLS>~
          SPRINT new_desc ~– Gains Bard-exclusive spells as priest spells.~
          GET_STRREF %kit_desc% desc_text
          INNER_PATCH_SAVE desc_text ~%desc_text%~ BEGIN
            REPLACE_TEXTUALLY ~%old_desc%~ ~
%new_desc%~
          END
            SET_2DA_ENTRY index 4 col_count RESOLVE_STR_REF (~%desc_text%~)
            INNER_ACTION BEGIN
            OUTER_SET new_description = RESOLVE_STR_REF (~%desc_text%~)
            END
            PRETTY_PRINT_2DA
		END
		  END
		  END

      COPY_EXISTING ~KITLIST.2DA~ ~override~
      COUNT_2DA_COLS col_count
      COUNT_2DA_ROWS col_count rows
      FOR (index = 1; index < rows; ++index) BEGIN
        READ_2DA_ENTRY index 1 col_count row_name
        READ_2DA_ENTRY index 8 col_count class_id
//inspiration
        PATCH_IF "%row_name%" STRING_EQUAL_CASE "C0_GALLANT" BEGIN
          SET_2DA_ENTRY index 4 col_count new_description
            PRETTY_PRINT_2DA
		      END
		  END

      BUT_ONLY
    END
END
