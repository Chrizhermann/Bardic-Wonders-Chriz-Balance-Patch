// Symphony of the Dark Children is only available with this finite-duration
// controller. If the controller contract is not recognized, the HLA remains
// absent rather than falling back to a toggle-compatible implementation.

DEFINE_PATCH_FUNCTION C0_VALIDATE_ABETTOR_EFF_RESERVED_FIELDS
  RET
    valid
BEGIN
  SET valid = 0
  PATCH_IF (BUFFER_LENGTH = 0x110) BEGIN
    SET reserved_valid = 1
    FOR (reserved_offset = 0x38; reserved_offset < 0x80; ++reserved_offset) BEGIN
      READ_BYTE reserved_offset reserved_byte
      PATCH_IF (reserved_byte != 0) BEGIN SET reserved_valid = 0 END
    END
    FOR (reserved_offset = 0x80; reserved_offset < 0x90; ++reserved_offset) BEGIN
      READ_BYTE reserved_offset reserved_byte
      PATCH_IF (reserved_byte != 0xff) BEGIN SET reserved_valid = 0 END
    END
    FOR (reserved_offset = 0x90; reserved_offset < 0xa4; ++reserved_offset) BEGIN
      READ_BYTE reserved_offset reserved_byte
      PATCH_IF (reserved_byte != 0) BEGIN SET reserved_valid = 0 END
    END
    FOR (reserved_offset = 0xa4; reserved_offset < 0xa8; ++reserved_offset) BEGIN
      READ_BYTE reserved_offset reserved_byte
      PATCH_IF (reserved_byte != 0xff) BEGIN SET reserved_valid = 0 END
    END
    FOR (reserved_offset = 0xa8; reserved_offset < 0xcc; ++reserved_offset) BEGIN
      READ_BYTE reserved_offset reserved_byte
      PATCH_IF (reserved_byte != 0) BEGIN SET reserved_valid = 0 END
    END
    READ_LONG 0xcc caster_level
    FOR (reserved_offset = 0xd0; reserved_offset < 0x110; ++reserved_offset) BEGIN
      READ_BYTE reserved_offset reserved_byte
      PATCH_IF (reserved_byte != 0) BEGIN SET reserved_valid = 0 END
    END
    PATCH_IF (reserved_valid = 1) AND (caster_level = 1) BEGIN SET valid = 1 END
  END
END

DEFINE_PATCH_FUNCTION C0_VALIDATE_ABETTOR_PAYLOAD_EFF
  STR_VAR
    expected_resource = ~~
  RET
    valid
BEGIN
  SET valid = 0
  LPF C0_VALIDATE_ABETTOR_EFF_RESERVED_FIELDS RET reserved_fields_valid = valid END
  PATCH_IF (BUFFER_LENGTH >= 0x110) BEGIN
    READ_ASCII 0 signature (8)
    READ_ASCII 0x08 secondary_signature (8)
    READ_LONG 0x10 opcode
    READ_LONG 0x14 target
    READ_LONG 0x18 power
    READ_LONG 0x1c parameter1
    READ_LONG 0x20 parameter2
    READ_LONG 0x24 timing
    READ_LONG 0x28 duration
    READ_SHORT 0x2c probability1
    READ_SHORT 0x2e probability2
    READ_ASCII 0x30 resource (8) NULL
    SET resource_length = STRING_LENGTH ~%resource%~
    SET resource_padding_valid = 1
    FOR (resource_index = resource_length; resource_index < 8; ++resource_index) BEGIN
      READ_BYTE (0x30 + resource_index) resource_padding_byte
      PATCH_IF (resource_padding_byte != 0) BEGIN
        SET resource_padding_valid = 0
      END
    END
    PATCH_IF
      (~%signature%~ STRING_EQUAL_CASE ~EFF V2.0~)
      AND (~%secondary_signature%~ STRING_EQUAL_CASE ~EFF V2.0~)
      AND (opcode = 146)
      AND (target = 1)
      AND (power = 0)
      AND (parameter1 = 0)
      AND (parameter2 = 1)
      AND (timing = 1)
      AND (duration = 0)
      AND (probability1 = 100)
      AND (probability2 = 0)
      AND (~%resource%~ STRING_EQUAL_CASE ~%expected_resource%~)
      AND (resource_padding_valid = 1)
      AND (reserved_fields_valid = 1)
    BEGIN
      SET valid = 1
    END
  END
END

DEFINE_PATCH_FUNCTION C0_VALIDATE_ABETTOR_FINITE_CONTROLLER
  INT_VAR
    expected_start_hooks = 0
    expected_end_hooks = 0
  STR_VAR
    expected_payload = ~~
  RET
    valid
    ability_count
BEGIN
  SET valid = 0
  SET ability_count = 0
  PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
    READ_ASCII 0 signature (8)
    READ_SHORT 0x1c spell_type
    READ_LONG 0x64 ability_offset
    READ_SHORT 0x68 ability_count
    READ_LONG 0x6a effect_offset
    READ_SHORT 0x6e first_global_effect
    READ_SHORT 0x70 global_effect_count
    SET first_global_offset = effect_offset + first_global_effect * 0x30
    SET global_effect_end = first_global_offset + global_effect_count * 0x30
    PATCH_IF
      (~%signature%~ STRING_EQUAL_CASE ~SPL V1  ~)
      AND (spell_type = 5)
      AND (ability_count > 0)
      // C0BARDSO contributes its two casting-level reset/start effects.
      AND (global_effect_count = 2)
      AND ((ability_offset + ability_count * 0x28) <= BUFFER_LENGTH)
      AND (global_effect_end <= BUFFER_LENGTH)
    BEGIN
      SET global_effects_valid = 0
      SET global_reset = first_global_offset
      SET global_start = first_global_offset + 0x30
      READ_SHORT global_reset global_reset_opcode
      READ_BYTE (global_reset + 0x02) global_reset_target
      READ_BYTE (global_reset + 0x03) global_reset_power
      READ_LONG (global_reset + 0x04) global_reset_parameter1
      READ_LONG (global_reset + 0x08) global_reset_parameter2
      READ_BYTE (global_reset + 0x0c) global_reset_timing
      READ_BYTE (global_reset + 0x0d) global_reset_resist_dispel
      READ_LONG (global_reset + 0x0e) global_reset_duration
      READ_BYTE (global_reset + 0x12) global_reset_probability1
      READ_BYTE (global_reset + 0x13) global_reset_probability2
      READ_ASCII (global_reset + 0x14) global_reset_resource (8) NULL
      READ_LONG (global_reset + 0x1c) global_reset_dice_count
      READ_LONG (global_reset + 0x20) global_reset_dice_size
      READ_LONG (global_reset + 0x24) global_reset_save_type
      READ_LONG (global_reset + 0x28) global_reset_save_bonus
      READ_LONG (global_reset + 0x2c) global_reset_special
      READ_SHORT global_start global_start_opcode
      READ_BYTE (global_start + 0x02) global_start_target
      READ_BYTE (global_start + 0x03) global_start_power
      READ_LONG (global_start + 0x04) global_start_parameter1
      READ_LONG (global_start + 0x08) global_start_parameter2
      READ_BYTE (global_start + 0x0c) global_start_timing
      READ_BYTE (global_start + 0x0d) global_start_resist_dispel
      READ_LONG (global_start + 0x0e) global_start_duration
      READ_BYTE (global_start + 0x12) global_start_probability1
      READ_BYTE (global_start + 0x13) global_start_probability2
      READ_ASCII (global_start + 0x14) global_start_resource (8) NULL
      READ_LONG (global_start + 0x1c) global_start_dice_count
      READ_LONG (global_start + 0x20) global_start_dice_size
      READ_LONG (global_start + 0x24) global_start_save_type
      READ_LONG (global_start + 0x28) global_start_save_bonus
      READ_LONG (global_start + 0x2c) global_start_special
      PATCH_IF
        (global_reset_opcode = 136)
        AND (global_reset_target = 9)
        AND (global_reset_power = 0)
        AND (global_reset_parameter1 = 0)
        AND (global_reset_parameter2 = 0)
        AND (global_reset_timing = 1)
        AND (global_reset_resist_dispel = 0)
        AND (global_reset_duration = 0)
        AND (global_reset_probability1 = 100)
        AND (global_reset_probability2 = 0)
        AND (~%global_reset_resource%~ STRING_EQUAL_CASE ~~)
        AND (global_reset_dice_count = 0)
        AND (global_reset_dice_size = 0)
        AND (global_reset_save_type = 0)
        AND (global_reset_save_bonus = 0)
        AND (global_reset_special = 0)
        AND (global_start_opcode = 146)
        AND (global_start_target = 9)
        AND (global_start_power = 0)
        AND (global_start_parameter1 = 0)
        AND (global_start_parameter2 = 1)
        AND (global_start_timing = 1)
        AND (global_start_resist_dispel = 0)
        AND (global_start_duration = 0)
        AND (global_start_probability1 = 100)
        AND (global_start_probability2 = 0)
        AND (~%global_start_resource%~ STRING_EQUAL_CASE ~C0BARDSX~)
        AND (global_start_dice_count = 0)
        AND (global_start_dice_size = 0)
        AND (global_start_save_type = 0)
        AND (global_start_save_bonus = 0)
        AND (global_start_special = 0)
      BEGIN
        SET global_effects_valid = 1
      END
      SET valid_headers = 0
      FOR (header_index = 0; header_index < ability_count; ++header_index) BEGIN
        SET header_offset = ability_offset + header_index * 0x28
        READ_BYTE header_offset ability_type
        READ_BYTE (header_offset + 0x01) ability_unknown
        READ_SHORT (header_offset + 0x02) ability_location
        READ_ASCII (header_offset + 0x04) ability_icon (8) NULL
        READ_BYTE (header_offset + 0x0c) ability_target
        READ_BYTE (header_offset + 0x0d) ability_target_count
        READ_SHORT (header_offset + 0x0e) ability_range
        READ_SHORT (header_offset + 0x10) ability_required_level
        READ_SHORT (header_offset + 0x12) ability_casting_time
        READ_SHORT (header_offset + 0x14) ability_times_per_day
        READ_SHORT (header_offset + 0x16) ability_dice_sides
        READ_SHORT (header_offset + 0x18) ability_dice_thrown
        READ_SHORT (header_offset + 0x1a) ability_enchanted
        READ_SHORT (header_offset + 0x1c) ability_damage_type
        READ_SHORT (header_offset + 0x1e) header_effect_count
        READ_SHORT (header_offset + 0x20) first_effect
        READ_SHORT (header_offset + 0x22) ability_charges
        READ_SHORT (header_offset + 0x24) ability_depletion
        READ_SHORT (header_offset + 0x26) ability_projectile
        SET first_effect_offset = effect_offset + first_effect * 0x30
        SET header_effect_end = first_effect_offset + header_effect_count * 0x30
        PATCH_IF
          (ability_type = 1)
          AND (ability_unknown = 0)
          AND (ability_location = 4)
          AND (~%ability_icon%~ STRING_EQUAL_CASE ~~)
          AND (ability_target = 1)
          AND (ability_target_count = 0)
          AND (ability_range = 1)
          AND (ability_required_level > 0)
          AND (ability_casting_time = 0)
          AND (ability_times_per_day = 0)
          AND (ability_dice_sides = 0)
          AND (ability_dice_thrown = 0)
          AND (ability_enchanted = 0)
          AND (ability_damage_type = 1)
          AND (ability_charges = 1)
          AND (ability_depletion = 1)
          AND (ability_projectile = 1)
          AND (header_effect_end <= BUFFER_LENGTH)
        BEGIN
          SET generic_start_count = 0
          SET generic_repeat_count = 0
          SET generic_end_count = 0
          SET generic_end_selector_count = 0
          SET reset_count = 0
          SET cast_count = 0
          SET cooldown_count = 0
          SET payload_once_count = 0
          SET payload_repeat_count = 0
          SET start_hook_count = 0
          SET end_hook_count = 0
          SET start_hook_resource_count = 0
          SET end_hook_resource_count = 0
          SET direct_invisibility_resource_count = 0
          SET once_duration = 0
          SET repeat_duration = 0
          SET end_duration = 0
          SET generic_repeat_duration = 0
          SET cooldown_duration = 0
          FOR (
            effect_index = 0;
            effect_index < header_effect_count;
            ++effect_index
          ) BEGIN
            SET current_effect = first_effect_offset + effect_index * 0x30
            READ_SHORT current_effect opcode
            READ_BYTE (current_effect + 0x02) target
            READ_BYTE (current_effect + 0x03) power
            READ_LONG (current_effect + 0x04) parameter1
            READ_LONG (current_effect + 0x08) parameter2
            READ_BYTE (current_effect + 0x0c) timing
            READ_BYTE (current_effect + 0x0d) resist_dispel
            READ_LONG (current_effect + 0x0e) duration
            READ_BYTE (current_effect + 0x12) probability1
            READ_BYTE (current_effect + 0x13) probability2
            READ_ASCII (current_effect + 0x14) resource (8) NULL
            READ_LONG (current_effect + 0x1c) dice_count
            READ_LONG (current_effect + 0x20) dice_size
            READ_LONG (current_effect + 0x24) save_type
            READ_LONG (current_effect + 0x28) save_bonus
            READ_LONG (current_effect + 0x2c) special

            // Reserved hook resources must not already appear in a partial or
            // malformed state that the exact semantic counters would ignore.
            PATCH_IF (~%resource%~ STRING_EQUAL_CASE ~C0ABIVS~) BEGIN
              SET start_hook_resource_count += 1
            END
            PATCH_IF (~%resource%~ STRING_EQUAL_CASE ~C0ABIVE~) BEGIN
              SET end_hook_resource_count += 1
            END
            PATCH_IF (~%resource%~ STRING_EQUAL_CASE ~C0ABIVI~) BEGIN
              SET direct_invisibility_resource_count += 1
            END

            SET inherited_fields_valid = 0
            PATCH_IF
              (power = 0)
              AND (resist_dispel = 0)
              AND (dice_count = 0)
              AND (dice_size = 0)
              AND (save_type = 0)
              AND (save_bonus = 0)
            BEGIN
              SET inherited_fields_valid = 1
            END

            PATCH_IF
              (inherited_fields_valid = 1)
              AND (opcode = 138)
              AND (target = 9)
              AND (parameter1 = 0)
              AND (parameter2 = 2)
              AND (timing = 1)
              AND (duration = 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~~)
              AND (special = 0)
            BEGIN
              SET reset_count += 1
            END
            PATCH_IF
              (inherited_fields_valid = 1)
              AND (opcode = 146)
              AND (target = 9)
              AND (parameter1 = 0)
              AND (parameter2 = 1)
              AND (timing = 1)
              AND (duration = 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~C0BARDSX~)
              AND (special = 0)
            BEGIN
              SET cast_count += 1
            END

            PATCH_IF
              (inherited_fields_valid = 1)
              AND
              (opcode = 177)
              AND (target = 9)
              AND (power = 0)
              AND (parameter1 = 0)
              AND (parameter2 = 2)
              AND (timing = 1)
              AND (duration = 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~C0SINGIN~)
              AND (special = 0)
            BEGIN
              SET generic_start_count += 1
            END
            PATCH_IF
              (inherited_fields_valid = 1)
              AND
              (opcode = 272)
              AND (target = 9)
              AND (power = 0)
              AND (parameter1 = 6)
              AND (parameter2 = 3)
              AND (timing = 10)
              AND (duration > 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~C0SINGI2~)
              AND (special = 40)
            BEGIN
              SET generic_end_count += 1
              SET end_duration = duration
            END
            // CLONE_EFFECT cannot match the donor's dynamic duration.  Refuse
            // any second effect that its otherwise-exact selector could clone.
            PATCH_IF
              (inherited_fields_valid = 1)
              AND
              (opcode = 272)
              AND (target = 9)
              AND (power = 0)
              AND (parameter1 = 6)
              AND (parameter2 = 3)
              AND (timing = 10)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~C0SINGI2~)
              AND (special = 40)
            BEGIN
              SET generic_end_selector_count += 1
            END
            PATCH_IF
              (inherited_fields_valid = 1)
              AND
              (opcode = 177)
              AND (target = 9)
              AND (power = 0)
              AND (parameter1 = 0)
              AND (parameter2 = 2)
              AND (timing = 10)
              AND (duration > 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~%expected_payload%~)
              AND (special = 0)
            BEGIN
              SET payload_once_count += 1
              SET once_duration = duration
            END
            PATCH_IF
              (inherited_fields_valid = 1)
              AND
              (opcode = 272)
              AND (target = 9)
              AND (power = 0)
              AND (parameter1 = 6)
              AND (parameter2 = 3)
              AND (timing = 10)
              AND (duration > 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~%expected_payload%~)
              AND (special = 40)
            BEGIN
              SET payload_repeat_count += 1
              SET repeat_duration = duration
            END
            PATCH_IF
              (inherited_fields_valid = 1)
              AND (opcode = 272)
              AND (target = 9)
              AND (parameter1 = 6)
              AND (parameter2 = 3)
              AND (timing = 10)
              AND (duration > 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~C0SINGIN~)
              AND (special = 40)
            BEGIN
              SET generic_repeat_count += 1
              SET generic_repeat_duration = duration
            END
            PATCH_IF
              (inherited_fields_valid = 1)
              AND (opcode = 328)
              AND (target = 9)
              AND (parameter1 = 0)
              AND (parameter2 = 85)
              AND (timing = 10)
              AND (duration > 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~%expected_payload%~)
              AND (special = 1)
            BEGIN
              SET cooldown_count += 1
              SET cooldown_duration = duration
            END
            PATCH_IF
              (inherited_fields_valid = 1)
              AND
              (opcode = 177)
              AND (target = 9)
              AND (power = 0)
              AND (parameter1 = 0)
              AND (parameter2 = 2)
              AND (timing = 1)
              AND (duration = 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~C0ABIVS~)
              AND (special = 0)
            BEGIN
              SET start_hook_count += 1
            END
            PATCH_IF
              (inherited_fields_valid = 1)
              AND
              (opcode = 272)
              AND (target = 9)
              AND (power = 0)
              AND (parameter1 = 6)
              AND (parameter2 = 3)
              AND (timing = 10)
              AND (duration > 0)
              AND (probability1 = 100)
              AND (probability2 = 0)
              AND (~%resource%~ STRING_EQUAL_CASE ~C0ABIVE~)
              AND (special = 40)
            BEGIN
              SET end_hook_count += 1
            END
          END
          PATCH_IF
            (generic_start_count = 1)
            AND (generic_repeat_count = 1)
            AND (generic_end_count = 1)
            AND (generic_end_selector_count = 1)
            AND (reset_count = 1)
            AND (cast_count = 1)
            AND (cooldown_count = 1)
            AND (payload_once_count = 1)
            AND (payload_repeat_count = 1)
            AND (start_hook_resource_count = expected_start_hooks)
            AND (start_hook_count = expected_start_hooks)
            AND (end_hook_resource_count = expected_end_hooks)
            AND (end_hook_count = expected_end_hooks)
            AND (direct_invisibility_resource_count = 0)
            AND (once_duration = repeat_duration)
            AND (repeat_duration = end_duration)
            AND (end_duration = generic_repeat_duration)
            AND (generic_repeat_duration = cooldown_duration)
          BEGIN
            SET valid_headers += 1
          END
        END
      END
      PATCH_IF (global_effects_valid = 1) AND (valid_headers = ability_count) BEGIN
        SET valid = 1
      END
    END
  END
END

DEFINE_PATCH_FUNCTION C0_VALIDATE_ABETTOR_INVISIBILITY_TEMPLATE
  RET
    valid
BEGIN
  SET valid = 0
  PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
    READ_ASCII 0 signature (8)
    READ_SHORT 0x1c spell_type
    READ_LONG 0x64 ability_offset
    READ_SHORT 0x68 ability_count
    READ_LONG 0x6a effect_offset
    READ_SHORT 0x70 global_effect_count
    PATCH_IF
      (~%signature%~ STRING_EQUAL_CASE ~SPL V1  ~)
      AND (spell_type = 5)
      AND (ability_count = 1)
      AND (global_effect_count = 0)
      AND ((ability_offset + 0x28) <= BUFFER_LENGTH)
    BEGIN
      READ_BYTE ability_offset ability_type
      READ_BYTE (ability_offset + 0x01) ability_unknown
      READ_SHORT (ability_offset + 0x02) ability_location
      READ_ASCII (ability_offset + 0x04) ability_icon (8) NULL
      READ_BYTE (ability_offset + 0x0c) ability_target
      READ_BYTE (ability_offset + 0x0d) ability_target_count
      READ_SHORT (ability_offset + 0x0e) ability_range
      READ_SHORT (ability_offset + 0x10) ability_required_level
      READ_SHORT (ability_offset + 0x12) ability_casting_time
      READ_SHORT (ability_offset + 0x14) ability_times_per_day
      READ_SHORT (ability_offset + 0x16) ability_dice_sides
      READ_SHORT (ability_offset + 0x18) ability_dice_thrown
      READ_SHORT (ability_offset + 0x1a) ability_enchanted
      READ_SHORT (ability_offset + 0x1c) ability_damage_type
      READ_SHORT (ability_offset + 0x1e) effect_count
      READ_SHORT (ability_offset + 0x20) first_effect
      READ_SHORT (ability_offset + 0x22) ability_charges
      READ_SHORT (ability_offset + 0x24) ability_depletion
      READ_SHORT (ability_offset + 0x26) ability_projectile
      SET first_effect_offset = effect_offset + first_effect * 0x30
      PATCH_IF
        (ability_type = 1)
        AND (ability_unknown = 0)
        AND (ability_location = 4)
        AND (~%ability_icon%~ STRING_EQUAL_CASE ~~)
        AND (ability_target = 1)
        AND (ability_target_count = 0)
        AND (ability_range = 1)
        AND (ability_required_level = 1)
        AND (ability_casting_time = 0)
        AND (ability_times_per_day = 0)
        AND (ability_dice_sides = 0)
        AND (ability_dice_thrown = 0)
        AND (ability_enchanted = 0)
        AND (ability_damage_type = 1)
        AND (ability_charges = 1)
        AND (ability_depletion = 1)
        AND (ability_projectile = 1)
        AND (effect_count = 2)
        AND ((first_effect_offset + effect_count * 0x30) <= BUFFER_LENGTH)
      BEGIN
        SET display_count = 0
        SET animation_count = 0
        FOR (effect_index = 0; effect_index < effect_count; ++effect_index) BEGIN
          SET current_effect = first_effect_offset + effect_index * 0x30
          READ_SHORT current_effect opcode
          READ_BYTE (current_effect + 0x02) target
          READ_BYTE (current_effect + 0x03) power
          READ_LONG (current_effect + 0x04) parameter1
          READ_LONG (current_effect + 0x08) parameter2
          READ_BYTE (current_effect + 0x0c) timing
          READ_BYTE (current_effect + 0x0d) resist_dispel
          READ_LONG (current_effect + 0x0e) duration
          READ_BYTE (current_effect + 0x12) probability1
          READ_BYTE (current_effect + 0x13) probability2
          READ_ASCII (current_effect + 0x14) resource (8) NULL
          READ_LONG (current_effect + 0x1c) dice_count
          READ_LONG (current_effect + 0x20) dice_size
          READ_LONG (current_effect + 0x24) save_type
          READ_LONG (current_effect + 0x28) save_bonus
          READ_LONG (current_effect + 0x2c) special
          SET template_effect_valid = 0
          PATCH_IF
            (target = 1)
            AND (power = 0)
            AND (parameter1 = 0)
            AND (parameter2 = 0)
            AND (timing = 1)
            AND (resist_dispel = 0)
            AND (duration = 0)
            AND (probability1 = 100)
            AND (probability2 = 0)
            AND (~%resource%~ STRING_EQUAL_CASE ~~)
            AND (dice_count = 0)
            AND (dice_size = 0)
            AND (save_type = 0)
            AND (save_bonus = 0)
            AND (special = 0)
          BEGIN
            SET template_effect_valid = 1
          END
          PATCH_IF (template_effect_valid = 1) AND (opcode = 139) BEGIN
            SET display_count += 1
          END
          PATCH_IF (template_effect_valid = 1) AND (opcode = 136) BEGIN
            SET animation_count += 1
          END
        END
        PATCH_IF (display_count = 1) AND (animation_count = 1) BEGIN
          SET valid = 1
        END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION C0_VALIDATE_ABETTOR_HOOK_TEMPLATE
  INT_VAR
    expected_parameter1 = 0
    expected_parameter2 = 0
  STR_VAR
    expected_resource = ~~
  RET
    valid
BEGIN
  SET valid = 0
  LPF C0_VALIDATE_ABETTOR_EFF_RESERVED_FIELDS RET reserved_fields_valid = valid END
  PATCH_IF (BUFFER_LENGTH >= 0x110) BEGIN
    READ_ASCII 0 signature (8)
    READ_ASCII 0x08 secondary_signature (8)
    READ_LONG 0x10 opcode
    READ_LONG 0x14 target
    READ_LONG 0x18 power
    READ_LONG 0x1c parameter1
    READ_LONG 0x20 parameter2
    READ_LONG 0x24 timing
    READ_LONG 0x28 duration
    READ_SHORT 0x2c probability1
    READ_SHORT 0x2e probability2
    READ_ASCII 0x30 resource (8) NULL
    PATCH_IF
      (~%signature%~ STRING_EQUAL_CASE ~EFF V2.0~)
      AND (~%secondary_signature%~ STRING_EQUAL_CASE ~EFF V2.0~)
      AND (opcode = 326)
      AND (target = 1)
      AND (power = 0)
      AND (parameter1 = expected_parameter1)
      AND (parameter2 = expected_parameter2)
      AND (timing = 1)
      AND (duration = 0)
      AND (probability1 = 100)
      AND (probability2 = 0)
      AND (~%resource%~ STRING_EQUAL_CASE ~%expected_resource%~)
      AND (reserved_fields_valid = 1)
    BEGIN
      SET valid = 1
    END
  END
END

ACTION_IF
  (FILE_EXISTS_IN_GAME ~LUC0ABET.2DA~)
BEGIN
  // Defensive upgrade behavior: an older component 1004 may already have
  // exposed Symphony. Remove it before validation and add it back only after
  // the finite controller has been patched and revalidated.
  COPY_EXISTING ~LUC0ABET.2DA~ ~override~
    LPF patch_remove_hla STR_VAR remove_ability = ~AP_C0ABETHL~ END
  BUT_ONLY

  OUTER_SET c0_abettor_pointer_valid = 0
  OUTER_SET c0_abettor_payload_eff_valid = 0
  OUTER_SET c0_abettor_controller_valid = 0
  OUTER_SET c0_abettor_spell_template_valid = 0
  OUTER_SET c0_abettor_start_template_valid = 0
  OUTER_SET c0_abettor_end_template_valid = 0
  OUTER_SET c0_abettor_party_projectile = 0
  OUTER_SET c0_abettor_reserved_outputs_clear = 1
  OUTER_TEXT_SPRINT c0_abettor_payload ~~

  ACTION_IF
    (FILE_EXISTS_IN_GAME ~C0ABIVI.SPL~)
    OR (FILE_EXISTS_IN_GAME ~C0ABIVS.EFF~)
    OR (FILE_EXISTS_IN_GAME ~C0ABIVE.EFF~)
  BEGIN
    OUTER_SET c0_abettor_reserved_outputs_clear = 0
    WARN ~Reserved Abettor Invisibility resources already exist; skipping Symphony of the Dark Children.~
  END

  ACTION_IF
    (FILE_EXISTS_IN_GAME ~C0ABETHL.SPL~)
    AND (FILE_EXISTS_IN_GAME ~C0ABETS2.SPL~)
    AND (FILE_EXISTS_IN_GAME ~C0ABETS2.EFF~)
    AND (FILE_EXISTS_IN_GAME ~C0SINGIN.SPL~)
    AND (FILE_EXISTS_IN_GAME ~C0SINGIN.EFF~)
    AND (FILE_EXISTS_IN_GAME ~C0SINGI2.EFF~)
  BEGIN
    COPY_EXISTING ~C0ABETS2.EFF~ ~override~
      PATCH_IF (BUFFER_LENGTH >= 0x110) BEGIN
        LPF C0_VALIDATE_ABETTOR_EFF_RESERVED_FIELDS RET reserved_fields_valid = valid END
        READ_ASCII 0 signature (8)
        READ_ASCII 0x08 secondary_signature (8)
        READ_LONG 0x10 opcode
        READ_LONG 0x14 target
        READ_LONG 0x18 power
        READ_LONG 0x1c parameter1
        READ_LONG 0x20 parameter2
        READ_LONG 0x24 timing
        READ_LONG 0x28 duration
        READ_SHORT 0x2c probability1
        READ_SHORT 0x2e probability2
        READ_ASCII 0x30 payload (8) NULL
        SET payload_length = STRING_LENGTH ~%payload%~
        SET payload_padding_valid = 1
        FOR (payload_index = payload_length; payload_index < 8; ++payload_index) BEGIN
          READ_BYTE (0x30 + payload_index) payload_padding_byte
          PATCH_IF (payload_padding_byte != 0) BEGIN
            SET payload_padding_valid = 0
          END
        END
        PATCH_IF
          (~%signature%~ STRING_EQUAL_CASE ~EFF V2.0~)
          AND (~%secondary_signature%~ STRING_EQUAL_CASE ~EFF V2.0~)
          AND (opcode = 146)
          AND (target = 1)
          AND (power = 0)
          AND (parameter1 = 0)
          AND (parameter2 = 1)
          AND (timing = 1)
          AND (duration = 0)
          AND (probability1 = 100)
          AND (probability2 = 0)
          AND ((STRING_LENGTH ~%payload%~) > 0)
          AND (~%payload%~ STRING_MATCHES_REGEXP ~^[A-Za-z0-9_#@-][A-Za-z0-9_#@-]*$~ = 0)
          AND !(~%payload%~ STRING_EQUAL_CASE ~C0ABIVI~)
          AND !(~%payload%~ STRING_EQUAL_CASE ~C0ABIVS~)
          AND !(~%payload%~ STRING_EQUAL_CASE ~C0ABIVE~)
          AND (payload_padding_valid = 1)
          AND (reserved_fields_valid = 1)
        BEGIN
          INNER_ACTION BEGIN
            OUTER_TEXT_SPRINT c0_abettor_payload ~%payload%~
            OUTER_SET c0_abettor_pointer_valid = 1
          END
        END
      END
    BUT_ONLY

    ACTION_IF
      (c0_abettor_pointer_valid = 1)
      AND (FILE_EXISTS_IN_GAME ~%c0_abettor_payload%.SPL~)
    BEGIN
      COPY_EXISTING ~%c0_abettor_payload%.SPL~ ~override~
        PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
          READ_ASCII 0 signature (8)
          READ_SHORT 0x1c spell_type
          READ_LONG 0x64 ability_offset
          READ_SHORT 0x68 ability_count
          READ_LONG 0x6a effect_offset
          READ_SHORT 0x70 global_effect_count
          PATCH_IF
            (~%signature%~ STRING_EQUAL_CASE ~SPL V1  ~)
            AND (spell_type = 5)
            AND (ability_count = 1)
            AND (global_effect_count = 0)
            AND ((ability_offset + 0x28) <= BUFFER_LENGTH)
          BEGIN
            READ_BYTE ability_offset ability_type
            READ_BYTE (ability_offset + 0x01) ability_unknown
            READ_SHORT (ability_offset + 0x02) ability_location
            READ_ASCII (ability_offset + 0x04) ability_icon (8) NULL
            READ_BYTE (ability_offset + 0x0c) ability_target
            READ_BYTE (ability_offset + 0x0d) ability_target_count
            READ_SHORT (ability_offset + 0x0e) ability_range
            READ_SHORT (ability_offset + 0x10) ability_required_level
            READ_SHORT (ability_offset + 0x12) ability_casting_time
            READ_SHORT (ability_offset + 0x14) ability_times_per_day
            READ_SHORT (ability_offset + 0x16) ability_dice_sides
            READ_SHORT (ability_offset + 0x18) ability_dice_thrown
            READ_SHORT (ability_offset + 0x1a) ability_enchanted
            READ_SHORT (ability_offset + 0x1c) ability_damage_type
            READ_SHORT (ability_offset + 0x1e) effect_count
            READ_SHORT (ability_offset + 0x20) first_effect
            READ_SHORT (ability_offset + 0x22) ability_charges
            READ_SHORT (ability_offset + 0x24) ability_depletion
            READ_SHORT (ability_offset + 0x26) party_projectile
            SET first_effect_offset = effect_offset + first_effect * 0x30
            PATCH_IF
              (ability_type = 1)
              AND (ability_unknown = 0)
              AND (ability_location = 4)
              AND (~%ability_icon%~ STRING_EQUAL_CASE ~~)
              AND (ability_target = 5)
              AND (ability_target_count = 0)
              AND (ability_range = 50)
              AND (ability_required_level = 1)
              AND (ability_casting_time = 0)
              AND (ability_times_per_day = 0)
              AND (ability_dice_sides = 6)
              AND (ability_dice_thrown = 0)
              AND (ability_enchanted = 0)
              AND (ability_damage_type = 1)
              AND (first_effect = 0)
              AND (ability_charges = 1)
              AND (ability_depletion = 1)
              AND (party_projectile = 158)
              AND ((first_effect_offset + effect_count * 0x30) <= BUFFER_LENGTH)
            BEGIN
              INNER_ACTION BEGIN
                OUTER_SET c0_abettor_party_projectile = party_projectile
              END
            END
          END
        END
      BUT_ONLY
    END

    ACTION_IF
      (c0_abettor_pointer_valid = 1)
      AND (FILE_EXISTS_IN_GAME ~%c0_abettor_payload%.EFF~)
    BEGIN
      COPY_EXISTING ~%c0_abettor_payload%.EFF~ ~override~
        LPF C0_VALIDATE_ABETTOR_PAYLOAD_EFF
          STR_VAR expected_resource = EVAL ~%c0_abettor_payload%~
          RET payload_eff_valid = valid
        END
        PATCH_IF (payload_eff_valid = 1) BEGIN
          INNER_ACTION BEGIN OUTER_SET c0_abettor_payload_eff_valid = 1 END
        END
      BUT_ONLY
    END

    COPY_EXISTING ~C0ABETS2.SPL~ ~override~
      LPF C0_VALIDATE_ABETTOR_FINITE_CONTROLLER
        INT_VAR
          expected_start_hooks = 0
          expected_end_hooks = 0
        STR_VAR
          expected_payload = EVAL ~%c0_abettor_payload%~
        RET
          controller_valid = valid
      END
      PATCH_IF (controller_valid = 1) BEGIN
        INNER_ACTION BEGIN
          OUTER_SET c0_abettor_controller_valid = 1
        END
      END
    BUT_ONLY

    COPY_EXISTING ~C0SINGIN.SPL~ ~override~
      LPF C0_VALIDATE_ABETTOR_INVISIBILITY_TEMPLATE
        RET
          template_valid = valid
      END
      PATCH_IF (template_valid = 1) BEGIN
        INNER_ACTION BEGIN
          OUTER_SET c0_abettor_spell_template_valid = 1
        END
      END
    BUT_ONLY

    COPY_EXISTING ~C0SINGIN.EFF~ ~override~
      LPF C0_VALIDATE_ABETTOR_HOOK_TEMPLATE
        INT_VAR
          expected_parameter2 = 0
        STR_VAR
          expected_resource = ~C0SINGIN~
        RET
          template_valid = valid
      END
      PATCH_IF (template_valid = 1) BEGIN
        INNER_ACTION BEGIN
          OUTER_SET c0_abettor_start_template_valid = 1
        END
      END
    BUT_ONLY

    COPY_EXISTING ~C0SINGI2.EFF~ ~override~
      LPF C0_VALIDATE_ABETTOR_HOOK_TEMPLATE
        INT_VAR
          expected_parameter1 = (0 - 2146422739)
          expected_parameter2 = 138
        STR_VAR
          expected_resource = ~C0SINGI2~
        RET
          template_valid = valid
      END
      PATCH_IF (template_valid = 1) BEGIN
        INNER_ACTION BEGIN
          OUTER_SET c0_abettor_end_template_valid = 1
        END
      END
    BUT_ONLY
  END

  ACTION_IF
      (c0_abettor_pointer_valid = 1)
      AND (c0_abettor_payload_eff_valid = 1)
      AND (FILE_EXISTS_IN_GAME ~%c0_abettor_payload%.SPL~)
    AND (c0_abettor_party_projectile = 158)
    AND (c0_abettor_reserved_outputs_clear = 1)
    AND (c0_abettor_controller_valid = 1)
    AND (c0_abettor_spell_template_valid = 1)
    AND (c0_abettor_start_template_valid = 1)
    AND (c0_abettor_end_template_valid = 1)
  BEGIN
    COPY_EXISTING ~C0SINGIN.SPL~ ~override/C0ABIVI.SPL~
      LPF DELETE_EFFECT
        INT_VAR
          check_headers = 1
          check_globals = 0
          match_opcode = 139
      END
      LPF DELETE_EFFECT
        INT_VAR
          check_headers = 1
          check_globals = 0
          match_opcode = 136
      END
      LPF ALTER_SPELL_HEADER
        INT_VAR
          target = 5
          range = 50
          projectile = c0_abettor_party_projectile
      END
      LPF ADD_SPELL_EFFECT
        INT_VAR
          opcode = 20
          target = 2
          parameter1 = 0
          parameter2 = 0
          timing = 0
          duration = 6
          probability1 = 100
          probability2 = 0
      END

    COPY_EXISTING ~C0SINGIN.EFF~ ~override/C0ABIVS.EFF~
      WRITE_ASCIIE 0x30 ~C0ABIVI~ (8)

    COPY_EXISTING ~C0SINGI2.EFF~ ~override/C0ABIVE.EFF~
      WRITE_ASCIIE 0x30 ~C0ABIVI~ (8)

    OUTER_SET c0_abettor_output_start_valid = 0
    COPY_EXISTING ~C0ABIVS.EFF~ ~override~
      LPF C0_VALIDATE_ABETTOR_HOOK_TEMPLATE
        INT_VAR expected_parameter2 = 0
        STR_VAR expected_resource = ~C0ABIVI~
        RET output_valid = valid
      END
      PATCH_IF (output_valid = 1) BEGIN
        INNER_ACTION BEGIN OUTER_SET c0_abettor_output_start_valid = 1 END
      END
    BUT_ONLY

    OUTER_SET c0_abettor_output_end_valid = 0
    COPY_EXISTING ~C0ABIVE.EFF~ ~override~
      LPF C0_VALIDATE_ABETTOR_HOOK_TEMPLATE
        INT_VAR
          expected_parameter1 = (0 - 2146422739)
          expected_parameter2 = 138
        STR_VAR expected_resource = ~C0ABIVI~
        RET output_valid = valid
      END
      PATCH_IF (output_valid = 1) BEGIN
        INNER_ACTION BEGIN OUTER_SET c0_abettor_output_end_valid = 1 END
      END
    BUT_ONLY

    COPY_EXISTING ~C0ABETS2.SPL~ ~override~
      LPF CLONE_EFFECT
        INT_VAR
          check_headers = 1
          check_globals = 0
          silent = 1
          match_opcode = 177
          match_target = 9
          match_power = 0
          match_parameter1 = 0
          match_parameter2 = 2
          match_timing = 1
          match_duration = 0
          match_probability1 = 100
          match_probability2 = 0
          match_resist_dispel = 0
          match_dicenumber = 0
          match_dicesize = 0
          match_savingthrow = 0
          match_savebonus = 0
          match_special = 0
        STR_VAR
          match_resource = C0SINGIN
          resource = C0ABIVS
      END
      LPF CLONE_EFFECT
        INT_VAR
          check_headers = 1
          check_globals = 0
          silent = 1
          match_opcode = 272
          match_target = 9
          match_power = 0
          match_parameter1 = 6
          match_parameter2 = 3
          match_timing = 10
          match_probability1 = 100
          match_probability2 = 0
          match_resist_dispel = 0
          match_dicenumber = 0
          match_dicesize = 0
          match_savingthrow = 0
          match_savebonus = 0
          match_special = 40
        STR_VAR
          match_resource = C0SINGI2
          resource = C0ABIVE
      END

    OUTER_SET c0_abettor_post_valid = 0
    COPY_EXISTING ~C0ABETS2.SPL~ ~override~
      LPF C0_VALIDATE_ABETTOR_FINITE_CONTROLLER
        INT_VAR
          expected_start_hooks = 1
          expected_end_hooks = 1
        STR_VAR
          expected_payload = EVAL ~%c0_abettor_payload%~
        RET
          controller_valid = valid
      END
      PATCH_IF (controller_valid = 1) BEGIN
        INNER_ACTION BEGIN
          OUTER_SET c0_abettor_post_valid = 1
        END
      END
    BUT_ONLY

    ACTION_IF
      (c0_abettor_post_valid = 1)
      AND (c0_abettor_output_start_valid = 1)
      AND (c0_abettor_output_end_valid = 1)
    BEGIN
      COPY_EXISTING ~LUC0ABET.2DA~ ~override~
        LPF patch_remove_hla STR_VAR remove_ability = ~AP_C0ABETHL~ END
        LPF patch_add_hla
          STR_VAR
            2da_row = ~C0ABET2~
            ability = ~AP_C0ABETHL~
            num_allowed = 1
            prerequisite = ~AP_C0ABETT5~
        END
      BUT_ONLY
      PRINT ~Symphony of the Dark Children enabled with finite-song opening and finale.~
    END ELSE BEGIN
      FAIL ~Abettor finite controller failed post-patch validation; rolling back component 2004.~
    END
  END ELSE BEGIN
    WARN ~Finite Abettor song controller was not recognized; skipping Symphony of the Dark Children.~
  END
END
