// Restore the HLA and its activation links independently of the optional
// invisibility effects at the start and end of the song.
ACTION_IF FILE_EXISTS_IN_GAME ~LUC0ABET.2DA~ BEGIN
  OUTER_SET hla_ready = 0
  OUTER_SET hla_linked = 0
  ACTION_IF ~%symphony_payload%~ STRING_COMPARE ~~ BEGIN
    LAF c0bw_resolve_core_asset INT_VAR asset_type = 5
      STR_VAR asset = ~C0ABETHL~ packaged = EVAL ~%MOD_FOLDER%/abettor/c0abethl.spl~
      RET hla_ready = ready RET_ARRAY c0bw_damaged_resources
    END
    ACTION_IF hla_ready BEGIN
      COPY_EXISTING - ~C0ABETHL.SPL~ ~.../c0bw-inlined/symphony-hla.spl~
        LPF c0bw_add_assignment_links
          STR_VAR bardsong_name = ~C0ABETS2~ song_name = EVAL ~%symphony_payload%~
          RET hla_linked = c0bw_linked RET_ARRAY c0bw_damaged_resources
        END
    END
  END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~C0ABETHL.SPL~ BEGIN
    COPY_EXISTING ~C0ABETHL.SPL~ ~override~
      SET asset_type = 5
      LPM c0bw_guard_core_asset
      SET hla_ready = c0bw_valid
    BUT_ONLY
  END

  OUTER_SET finale_installed = 0
  ACTION_IF hla_linked AND singing_eff_ready BEGIN
    COPY_EXISTING - ~C0SINGIN.SPL~ ~.../c0bw-inlined/symphony-invisibility.spl~
      LPF c0bw_extend_song_effects INT_VAR opcode = 20 target = 2 timing = 0 duration = 6 strip_messages = 1
        RET invisibility_ready = c0bw_extended RET_ARRAY c0bw_damaged_resources
      END
      PATCH_IF invisibility_ready BEGIN
        LPF ALTER_SPELL_HEADER INT_VAR target = 5 range = 50 projectile = song_party_projectile END
      END

    COPY_EXISTING - ~C0ABETS2.SPL~ ~.../c0bw-inlined/symphony-controller.spl~
      LPF c0bw_extend_song_effects INT_VAR opcode = 177 target = 9 parameter2 = 2 symphony = 1
        STR_VAR resource = ~C0ABIVS~
        RET finale_ready = c0bw_extended RET_ARRAY c0bw_damaged_resources
      END

    OUTER_SET finale_installed = invisibility_ready AND finale_ready
    ACTION_IF finale_installed BEGIN
      COPY_EXISTING ~C0SINGIN.EFF~ ~override/C0ABIVS.EFF~
        WRITE_ASCII 0x30 ~C0ABIVI~ (8)
      COPY ~.../c0bw-inlined/symphony-invisibility.spl~ ~override/C0ABIVI.SPL~
      COPY ~.../c0bw-inlined/symphony-controller.spl~ ~override/C0ABETS2.SPL~
    END
  END

  ACTION_IF hla_linked BEGIN
    INCLUDE ~%MOD_FOLDER%/lib/abettor_symphony.tpa~
    COPY ~.../c0bw-inlined/symphony-hla.spl~ ~override/C0ABETHL.SPL~
      LPF c0bw_describe_symphony INT_VAR with_finale = finale_installed END
    ACTION_IF finale_installed BEGIN
      PRINT ~Symphony of the Dark Children enabled with finite-song opening and finale.~
    END ELSE BEGIN
      PRINT ~Symphony of the Dark Children enabled.~
    END
  END

  ACTION_IF hla_linked OR NOT hla_ready BEGIN
    COPY_EXISTING ~LUC0ABET.2DA~ ~override~
      LPF patch_remove_hla STR_VAR remove_ability = ~AP_C0ABETHL~ END
      PATCH_IF hla_linked BEGIN
        LPF patch_add_hla STR_VAR 2da_row = ~C0ABET2~ ability = ~AP_C0ABETHL~
          num_allowed = 1 prerequisite = ~AP_C0ABETT5~
        END
      END
    BUT_ONLY
  END
END
