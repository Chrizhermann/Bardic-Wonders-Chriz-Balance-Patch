// Symphony is optional with the Abettor kit. Its controller and payload
// were written by c0bw_wrap_song in this component.
OUTER_SET symphony_templates_valid = 0
ACTION_IF FILE_EXISTS_IN_GAME ~LUC0ABET.2DA~ AND ~%symphony_payload%~ STRING_COMPARE ~~ BEGIN
  COPY ~%MOD_FOLDER%/bardsong/c0singin.spl~ ~override~
    LPM c0bw_guard_spl
    SET symphony_templates_valid = c0bw_valid
  BUT_ONLY
  COPY ~%MOD_FOLDER%/bardsong/c0singin.eff~ ~override~
    LPM c0bw_guard_eff
    SET symphony_templates_valid = symphony_templates_valid AND c0bw_valid
  BUT_ONLY
  COPY ~%MOD_FOLDER%/abettor/c0abethl.spl~ ~override~
    LPM c0bw_guard_spl
    SET symphony_templates_valid = symphony_templates_valid AND c0bw_valid
  BUT_ONLY
END
ACTION_IF symphony_templates_valid BEGIN
  COPY ~%MOD_FOLDER%/bardsong/c0singin.spl~ ~override/C0ABIVI.SPL~
    LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 139 END
    LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 136 END
    LPF ALTER_SPELL_HEADER INT_VAR target = 5 range = 50 projectile = song_party_projectile END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 20 target = 2 timing = 0 duration = 6
      probability1 = 100 probability2 = 0
    END

  COPY ~%MOD_FOLDER%/bardsong/c0singin.eff~ ~override/C0ABIVS.EFF~
    WRITE_ASCII 0x30 ~C0ABIVI~ (8)

  COPY_EXISTING ~C0ABETS2.SPL~ ~override~
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 177 target = 9 parameter2 = 2 timing = 1
      probability1 = 100 probability2 = 0
      STR_VAR resource = ~C0ABIVS~
    END
    // The shipped controller has 600 ticks at level one and adds 100 ticks
    // per header. Mode 4 takes whole seconds, rounded up at 15 ticks/second.
    FOR (song_header = 1; song_header <= 11; ++song_header) BEGIN
      LPF ADD_SPELL_EFFECT INT_VAR header = song_header opcode = 326 target = 9 timing = 4
        duration = (600 + (song_header - 1) * 100 + 14) / 15
        probability1 = 100 probability2 = 0
        STR_VAR resource = ~C0ABIVI~
      END
    END

  INCLUDE ~%MOD_FOLDER%/lib/abettor_symphony.tpa~
  COPY_EXISTING ~C0ABETHL.SPL~ ~override~
    LPF c0bw_link_song_assignment
      STR_VAR bardsong_name = ~C0ABETS2~ song_name = EVAL ~%symphony_payload%~
    END

  COPY_EXISTING ~LUC0ABET.2DA~ ~override~
    LPF patch_remove_hla STR_VAR remove_ability = ~AP_C0ABETHL~ END
    LPF patch_add_hla STR_VAR 2da_row = ~C0ABET2~ ability = ~AP_C0ABETHL~
      num_allowed = 1 prerequisite = ~AP_C0ABETT5~
    END
  PRINT ~Symphony of the Dark Children enabled with finite-song opening and finale.~
END
