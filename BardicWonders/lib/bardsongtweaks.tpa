INCLUDE ~%MOD_FOLDER%/lib/bardsong_registration.tpa~
ACTION_CLEAR_ARRAY c0bw_damaged_resources

LAF c0bw_resolve_core_asset INT_VAR asset_type = 1
  STR_VAR asset = ~C0BARDX~ packaged = EVAL ~%MOD_FOLDER%/bardsong/c0bardx.spl~
  RET loader_ready = ready RET_ARRAY c0bw_damaged_resources
END
LAF c0bw_resolve_wrapper_templates RET templates_ready templates_rejected controller_pulse RET_ARRAY c0bw_damaged_resources END
ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_song_messages BEGIN
  c0bardsx => ~Bard Song Ready~
  c0singin => ~Singing Bard Song~
END
OUTER_SET support_ready = 1
ACTION_PHP_EACH c0bw_song_messages AS spell => message BEGIN
  LAF c0bw_resolve_core_asset
    STR_VAR asset = EVAL ~%spell%~ packaged = EVAL ~%MOD_FOLDER%/bardsong/%spell%.spl~
    RET support_spell_ready = ready RET_ARRAY c0bw_damaged_resources
  END
  OUTER_SET support_ready = support_ready AND support_spell_ready
  ACTION_IF support_spell_ready BEGIN
    COPY_EXISTING ~%spell%.SPL~ ~override~
      LPF c0bw_alter_song_effects INT_VAR match_opcode = 139 parameter1 = RESOLVE_STR_REF (~%message%~) END
    BUT_ONLY
  END
END
COPY ~%MOD_FOLDER%/bardsong/c0brdef1.bam~ OVERRIDE
COPY ~%MOD_FOLDER%/bardsong/c0brdef1.vvc~ OVERRIDE
COPY ~%MOD_FOLDER%/bardsong/c0bardso.wav~ OVERRIDE
// C0SINGI2 suppresses stock delivery while the wrapper is active.
LAF c0bw_resolve_core_asset INT_VAR asset_type = 2 required_eff_opcode = 326
  STR_VAR asset = ~C0SINGI2~ packaged = EVAL ~%MOD_FOLDER%/bardsong/c0singi2.EFF~
  RET suppression_ready = ready RET_ARRAY c0bw_damaged_resources
END
OUTER_SET support_ready = support_ready AND suppression_ready
// C0SINGIN's effect provides presentation and the optional Symphony finale.
LAF c0bw_resolve_core_asset INT_VAR asset_type = 2 required_eff_opcode = 326
  STR_VAR asset = ~C0SINGIN~ packaged = EVAL ~%MOD_FOLDER%/bardsong/c0singin.EFF~
  RET singing_eff_ready = ready RET_ARRAY c0bw_damaged_resources
END
LAF c0bw_resolve_core_asset
  STR_VAR asset = ~C0SINGI2~ packaged = EVAL ~%MOD_FOLDER%/bardsong/c0singi2.spl~
  RET support_spell_ready = ready RET_ARRAY c0bw_damaged_resources
END
OUTER_SET support_ready = support_ready AND support_spell_ready

ACTION_IF FILE_EXISTS_IN_GAME ~C0BWHL8.spl~ THEN BEGIN
  ACTION_FOR_EACH song IN C0BWHL3 C0BWHL4 C0BWHL5 BEGIN
    COPY_EXISTING ~%song%.SPL~ ~override~
      LPM c0bw_guard_spl
      PATCH_IF c0bw_valid BEGIN WRITE_BYTE 0x1c 5 END
    BUT_ONLY
  END
  COPY_EXISTING ~C0BWHL8.SPL~ ~override~
    LPM c0bw_guard_spl
    PATCH_IF c0bw_valid BEGIN
      LPF c0bw_alter_song_effects INT_VAR match_opcode = 99 parameter1 = 130 END
    END
  BUT_ONLY
END

OUTER_SET iwd_modal_present = 0
OUTER_SET iwd_stock_projectile = 0
OUTER_SET iwd_enemy_projectile = 0
OUTER_SET iwd_jester_wrapper = 0
ACTION_IF GAME_IS ~iwdee~ BEGIN
  OUTER_SET iwd_jester_wrapper = MOD_IS_INSTALLED ~BardicWonders/Setup-BardicWonders.tp2~ ~1002~
  LAF c0bw_patch_iwd_modal_songs INT_VAR iwd_jester_wrapper
    RET iwd_modal_present iwd_stock_projectile iwd_enemy_projectile
    RET_ARRAY c0bw_damaged_resources
  END
END

ACTION_CLEAR_ARRAY c0bw_owned_songs
ACTION_CLEAR_ARRAY c0bw_owned_finite_songs
ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_owned_finite_songs BEGIN
  FJBARDA => C0BWSPA
  FJBLADEB => C0BWSPA
  FJBARDB => 1
  C0ABETSO => C0BWSPA
  C0KM#SO => C0BWSPA
  C0KM#SOH => C0BWSPA
  C0SKD02A => C0BWSPA
  C0TRBSO => C0BWSPA
  C0TRBSO2 => C0BWSPA
  C0DESP7 => 1
  C0DESP9 => 1
  C0BDD#S2 => C0BWSNP
  C0JES03A => C0BWSNP
  C0SDRUS2 => C0BWSNP
  C0SDRUSO => C0BWSNP
END
ACTION_IF NOT GAME_IS ~iwdee~ BEGIN
  ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_owned_finite_songs BEGIN
    SPCL542A => C0BWSPA
    SPCL920A => C0BWSPA
    SPCL751A => C0BWSNP
  END
END ELSE BEGIN
  ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_owned_finite_songs BEGIN FJBARDB => C0BWSPA END
  ACTION_IF iwd_jester_wrapper BEGIN
    ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_owned_finite_songs BEGIN SPCL751A => C0BWSIW END
  END
END
ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_owned_finite_songs BEGIN
  C0BDD#SO => C0BDD#SO
  C0ABETS2 => C0BWSPA
END
ACTION_PHP_EACH c0bw_owned_finite_songs AS song => profile BEGIN
  OUTER_SET $c0bw_owned_songs(~%song%~) = 1
END
LAF c0bw_find_external_songs RET_ARRAY c0bw_eligible_songs c0bw_damaged_resources END

OUTER_SET plan_attempted = loader_ready AND templates_ready AND support_ready
OUTER_SET startup_ready = 0
ACTION_IF plan_attempted BEGIN
  // Check only the shared controller here. Its PRO and ID remain staged
  // until a song can commit them together with its own payload delivery.
  LAF c0bw_plan_core_projectiles INT_VAR controller_only = 1
    RET startup_ready = profiles_ready RET_ARRAY c0bw_damaged_resources
  END
END
OUTER_SET finite_ready = 0
OUTER_SPRINT symphony_payload ""
ACTION_IF startup_ready BEGIN
  ACTION_CLEAR_ARRAY c0bw_finite_profiles
  OUTER_SET $c0bw_finite_profiles(1) = 1
  ACTION_IF iwd_stock_projectile > 0 BEGIN
    OUTER_SET $c0bw_finite_profiles(C0BWSPA) = iwd_stock_projectile
  END
  ACTION_IF iwd_enemy_projectile > 0 BEGIN
    OUTER_SET $c0bw_finite_profiles(C0BWSIW) = iwd_enemy_projectile
  END

  OUTER_SET c0bardso = 0
  OUTER_SET installed_wrappers = 0
  ACTION_PHP_EACH c0bw_owned_finite_songs AS song => profile BEGIN
    ACTION_IF ~%song%~ STRING_COMPARE ~C0ABETS2~ BEGIN
      OUTER_SET projectile = 0
      ACTION_IF VARIABLE_IS_SET $c0bw_finite_profiles(~%profile%~) BEGIN
        OUTER_SET projectile = $c0bw_finite_profiles(~%profile%~)
      END
      LAF c0bw_wrap_song INT_VAR payload_projectile = projectile templates_ready = 1 c0bardso
        STR_VAR controller_pulse bardsong_name = EVAL ~%song%~ stock_profile = EVAL ~%profile%~
        RET wrapped_song = song_name c0bardso projectile = payload_projectile
        RET_ARRAY c0bw_damaged_resources
      END
      ACTION_IF ~%wrapped_song%~ STRING_COMPARE ~~ BEGIN
        OUTER_SET installed_wrappers += 1
        OUTER_SET $c0bw_finite_profiles(~%profile%~) = projectile
      END
    END
  END
  OUTER_SET song_party_projectile = 0
  ACTION_IF VARIABLE_IS_SET $c0bw_finite_profiles(C0BWSPA) BEGIN
    OUTER_SET song_party_projectile = $c0bw_finite_profiles(C0BWSPA)
  END
  LAF c0bw_wrap_song INT_VAR payload_projectile = song_party_projectile templates_ready = 1 c0bardso
    STR_VAR controller_pulse bardsong_name = ~C0ABETS2~ stock_profile = ~C0BWSPA~
    RET symphony_payload = song_name c0bardso song_party_projectile = payload_projectile
    RET_ARRAY c0bw_damaged_resources
  END
  ACTION_IF ~%symphony_payload%~ STRING_COMPARE ~~ BEGIN
    OUTER_SET installed_wrappers += 1
  END
  LAF c0bw_wrap_external_songs INT_VAR c0bardso STR_VAR controller_pulse
    RET external_wrappers RET_ARRAY c0bw_damaged_resources
  END
  OUTER_SET finite_ready = installed_wrappers + external_wrappers > 0
END
INCLUDE ~%MOD_FOLDER%/lib/abettor_hla_finite.tpa~

ACTION_CLEAR_ARRAY c0bw_bard_clabs
ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_bard_clabs BEGIN CLABBA01 => 1 END
COPY_EXISTING ~KITLIST.2DA~ ~override~
  READ_2DA_ENTRIES_NOW kit_rows 10
  FOR (row = 1; row < kit_rows; ++row) BEGIN
    READ_2DA_ENTRY_FORMER kit_rows row 8 kit_class
    PATCH_IF kit_class = 5 BEGIN
      READ_2DA_ENTRY_FORMER kit_rows row 5 kit_clab
      TO_UPPER kit_clab
      SET $c0bw_bard_clabs(~%kit_clab%~) = 1
    END
  END
BUT_ONLY

ACTION_PHP_EACH c0bw_bard_clabs AS kit_clab => unused BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%kit_clab%.2DA~ BEGIN
    COPY_EXISTING ~%kit_clab%.2DA~ ~override~
      COUNT_2DA_COLS clab_columns
      READ_2DA_ENTRIES_NOW clab_rows clab_columns
      FOR (row = 0; row < clab_rows; ++row) BEGIN
        FOR (column = 1; column < clab_columns; ++column) BEGIN
          READ_2DA_ENTRY_FORMER clab_rows row column grant
          PATCH_IF ~%grant%~ STRING_EQUAL_CASE ~AP_C0BARDX~ BEGIN
            SET_2DA_ENTRY row column clab_columns ~****~
          END
        END
      END
      PATCH_IF finite_ready BEGIN
        LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_MaxLevel = 1 STR_VAR f_Entry = AP_C0BARDX END
        PRETTY_PRINT_2DA
      END
    BUT_ONLY
  END
END

ACTION_PHP_EACH c0bw_damaged_resources AS damaged_file => reason BEGIN
  ACTION_IF reason = 2 BEGIN
    PRINT ~Bardic Wonders #2004: skipping %damaged_file% at the 65535-effect capacity limit.~
  END ELSE ACTION_IF reason = 3 BEGIN
    PRINT ~Bardic Wonders #2004: no projectile IDs available for the required core projectiles (%damaged_file%).~
  END ELSE ACTION_IF reason = 4 BEGIN
    PRINT ~Bardic Wonders #2004: missing packaged %damaged_file%.~
  END ELSE BEGIN
    PRINT ~Bardic Wonders #2004: skipping damaged %damaged_file%.~
  END
END
INCLUDE ~%MOD_FOLDER%/lib/bardsong_description.tpa~
// WeiDU owns the explicit state across invocations and restores the original
// on uninstall. If there was no marker, an absent row already means inactive.
<<<<<<<< .../inlined/c0bw-song-state.2da
2DA V1.0
0
       FINITE
ACTIVE %finite_ready%
>>>>>>>>
ACTION_IF iwd_modal_present OR plan_attempted OR templates_rejected OR FILE_EXISTS_IN_GAME ~C0BWSYS.2DA~ BEGIN
  COPY ~.../inlined/c0bw-song-state.2da~ ~override/C0BWSYS.2DA~
    EVALUATE_BUFFER
END
ACTION_IF finite_ready BEGIN
  LAF c0bw_write_song_description END
END

COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~ //copies all spell files
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 200 parameter1 = 110 END
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 300 parameter1 = 120 END
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 400 parameter1 = 130 END
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 500 parameter1 = 140 END
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 600 parameter1 = 150 END
BUT_ONLY

ACTION_IF finite_ready BEGIN
  COPY_EXISTING ~enginest.2da~ ~override~
    COUNT_2DA_ROWS 2 rows
    FOR (row = 0; row < rows; ++row) BEGIN
      READ_2DA_ENTRY row 0 2 entry
      PATCH_IF ~%entry%~ STRING_EQUAL_CASE ~STRREF_FEEDBACK_BATTLESONGBEGIN~
        OR ~%entry%~ STRING_EQUAL_CASE ~STRREF_FEEDBACK_BATTLESONGEND~ BEGIN
        SET_2DA_ENTRY row 1 2 0
      END
    END
    PRETTY_PRINT_2DA
  BUT_ONLY

  COPY_EXISTING_REGEXP GLOB ~^.+\.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      REPLACE_TEXTUALLY ~!ModalState(BATTLESONG)~ ~!CheckSpellState(Myself,BARD_SONG)~
    END
    // Preserve the legacy trigger formatting pass.
    DECOMPILE_AND_PATCH BEGIN END
  BUT_ONLY
END
