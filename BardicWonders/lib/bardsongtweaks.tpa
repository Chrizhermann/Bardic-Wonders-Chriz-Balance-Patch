INCLUDE ~%MOD_FOLDER%/lib/bardsong_registration.tpa~
ACTION_CLEAR_ARRAY c0bw_damaged_resources

ADD_PROJECTILE ~%MOD_FOLDER%/bardsong/c0bardso.PRO~ ~C0 Bardsong~
COPY ~%MOD_FOLDER%/bardsong/c0bardso.PRO~ ~override~

INCLUDE ~%MOD_FOLDER%/lib/song_projectile.tpa~
LAF c0bw_song_projectile STR_VAR resref = ~C0BWSPA~ RET song_party_projectile = projectile END
LAF c0bw_song_projectile STR_VAR resref = ~C0BWSNP~ RET song_narrow_enemy_projectile = projectile END
OUTER_SET song_enemy_projectile = song_narrow_enemy_projectile
ACTION_IF GAME_IS ~iwdee~ BEGIN
  LAF c0bw_song_projectile STR_VAR resref = ~C0BWSIW~ RET song_enemy_projectile = projectile END
END

OUTER_SET c0bw_song_loader_ready = 0
ACTION_IF FILE_EXISTS ~%MOD_FOLDER%/bardsong/c0bardx.spl~ BEGIN
  COPY ~%MOD_FOLDER%/bardsong/c0bardx.spl~ ~override~
    LPM c0bw_guard_song_loader
    SET c0bw_song_loader_ready = c0bw_valid
  BUT_ONLY
END ELSE BEGIN
  PRINT ~Bardic Wonders #2004: missing packaged C0BARDX.SPL.~
  END
ACTION_IF c0bw_song_loader_ready BEGIN
  COPY ~%MOD_FOLDER%/bardsong/c0bardx.spl~ ~override~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~C0BARDX.SPL~ BEGIN
  COPY_EXISTING ~C0BARDX.SPL~ ~override~
    LPM c0bw_guard_song_loader
    SET c0bw_song_loader_ready = c0bw_valid
  BUT_ONLY
END

ACTION_CLEAR_ARRAY c0bw_bard_clabs
ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_bard_clabs BEGIN CLABBA01 => 1 END
COPY_EXISTING ~KITLIST.2DA~ ~override~
  READ_2DA_ENTRIES_NOW kit_rows 10
  FOR (row = 1; row < kit_rows; ++row) BEGIN
    READ_2DA_ENTRY_FORMER kit_rows row 8 kit_class
    PATCH_IF kit_class = 5 BEGIN
      READ_2DA_ENTRY_FORMER kit_rows row 5 kit_clab
      TO_UPPER kit_clab
      SET $c0bw_bard_clabs(~%kit_clab%~) = 1
    END
  END
BUT_ONLY

ACTION_PHP_EACH c0bw_bard_clabs AS kit_clab => unused BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%kit_clab%.2DA~ BEGIN
    COPY_EXISTING ~%kit_clab%.2DA~ ~override~
      COUNT_2DA_COLS clab_columns
      READ_2DA_ENTRIES_NOW clab_rows clab_columns
      FOR (row = 0; row < clab_rows; ++row) BEGIN
        FOR (column = 1; column < clab_columns; ++column) BEGIN
          READ_2DA_ENTRY_FORMER clab_rows row column grant
          PATCH_IF ~%grant%~ STRING_EQUAL_CASE ~AP_C0BARDX~ BEGIN
            SET_2DA_ENTRY row column clab_columns ~****~
          END
        END
      END
      PATCH_IF c0bw_song_loader_ready BEGIN
        LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_MaxLevel = 1 STR_VAR f_Entry = AP_C0BARDX END
        PRETTY_PRINT_2DA
      END
    BUT_ONLY
  END
END

ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_song_messages BEGIN
  c0bardsx => ~Bard Song Ready~
  c0singin => ~Singing Bard Song~
END
ACTION_PHP_EACH c0bw_song_messages AS spell => message BEGIN
  COPY ~%MOD_FOLDER%/bardsong/%spell%.spl~ ~override~
    LPM c0bw_guard_spl
  BUT_ONLY
  ACTION_IF c0bw_valid BEGIN
    COPY ~%MOD_FOLDER%/bardsong/%spell%.spl~ ~override~
      LPF c0bw_alter_song_effects INT_VAR match_opcode = 139 parameter1 = RESOLVE_STR_REF (~%message%~) END
  END
END
COPY ~%MOD_FOLDER%/bardsong/c0brdef1.bam~ OVERRIDE
COPY ~%MOD_FOLDER%/bardsong/c0brdef1.vvc~ OVERRIDE
COPY ~%MOD_FOLDER%/bardsong/c0bardso.wav~ OVERRIDE
ACTION_FOR_EACH effect IN c0singin c0singi2 BEGIN
  COPY ~%MOD_FOLDER%/bardsong/%effect%.eff~ ~override~
    LPM c0bw_guard_eff
  BUT_ONLY
  ACTION_IF c0bw_valid BEGIN
    COPY ~%MOD_FOLDER%/bardsong/%effect%.eff~ ~override~
  END
END
COPY ~%MOD_FOLDER%/bardsong/c0singi2.spl~ OVERRIDE
COPY ~%MOD_FOLDER%/bardsong/c0singi2.spl~ OVERRIDE

ACTION_IF FILE_EXISTS_IN_GAME ~C0BWHL8.spl~ THEN BEGIN
  ACTION_FOR_EACH song IN C0BWHL3 C0BWHL4 C0BWHL5 BEGIN
    COPY_EXISTING ~%song%.SPL~ ~override~
      LPM c0bw_guard_spl
      PATCH_IF c0bw_valid BEGIN WRITE_BYTE 0x1c 5 END
    BUT_ONLY
  END
  COPY_EXISTING ~C0BWHL8.SPL~ ~override~
    LPM c0bw_guard_spl
    PATCH_IF c0bw_valid BEGIN
      LPF c0bw_alter_song_effects INT_VAR match_opcode = 99 parameter1 = 130 END
    END
  BUT_ONLY
END

// The Icewind Dale repertoire is already a native modal. Change its delivery
// in place so the six selections and their continuous cadence are preserved.
OUTER_SET stock_bard_projectile = 1
ACTION_IF GAME_IS ~iwdee~ BEGIN
  OUTER_SET stock_bard_projectile = song_party_projectile
  LAF c0bw_song_projectile STR_VAR resref = ~C0BWSIA~ RET iwd_party_projectile = projectile END
  ACTION_FOR_EACH song IN SPCL115 SPCL116 SPCL117 SPCL119 SPCL120 SPCL542A BEGIN
    COPY_EXISTING ~%song%.SPL~ ~override~
      LPM c0bw_guard_spl
      PATCH_IF c0bw_valid BEGIN
        LPF ALTER_SPELL_HEADER INT_VAR projectile = iwd_party_projectile END
      END
    BUT_ONLY
  END
  COPY_EXISTING ~SPCL118.SPL~ ~override~
    LPM c0bw_guard_spl
    PATCH_IF c0bw_valid BEGIN
      LPF ALTER_SPELL_HEADER INT_VAR projectile = song_enemy_projectile END
    END
  BUT_ONLY
  COPY_EXISTING ~SPCL920A.SPL~ ~override~
    LPM c0bw_guard_spl
    PATCH_IF c0bw_valid BEGIN
      LPF ALTER_SPELL_HEADER INT_VAR projectile = song_party_projectile END
    END
  BUT_ONLY
  ACTION_IF NOT MOD_IS_INSTALLED ~BardicWonders/Setup-BardicWonders.tp2~ ~1002~ BEGIN
    COPY_EXISTING ~SPCL751A.SPL~ ~override~
      LPM c0bw_guard_spl
      PATCH_IF c0bw_valid BEGIN
        LPF ALTER_SPELL_HEADER INT_VAR projectile = song_enemy_projectile END
      END
    BUT_ONLY
  END
END

ACTION_CLEAR_ARRAY c0bw_owned_songs
ACTION_CLEAR_ARRAY c0bw_owned_finite_songs
ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_owned_finite_songs BEGIN
  FJBARDA => song_party_projectile
  FJBLADEB => song_party_projectile
  FJBARDB => stock_bard_projectile
  C0ABETSO => song_party_projectile
  C0KM#SO => song_party_projectile
  C0KM#SOH => song_party_projectile
  C0SKD02A => song_party_projectile
  C0TRBSO => song_party_projectile
  C0TRBSO2 => song_party_projectile
  C0DESP7 => 1
  C0DESP9 => 1
  C0BDD#S2 => song_narrow_enemy_projectile
  C0JES03A => song_narrow_enemy_projectile
  C0SDRUS2 => song_narrow_enemy_projectile
  C0SDRUSO => song_narrow_enemy_projectile
END
ACTION_IF NOT GAME_IS ~iwdee~ BEGIN
  ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_owned_finite_songs BEGIN
    SPCL542A => song_party_projectile
    SPCL920A => song_party_projectile
    SPCL751A => song_enemy_projectile
  END
END ELSE ACTION_IF MOD_IS_INSTALLED ~BardicWonders/Setup-BardicWonders.tp2~ ~1002~ BEGIN
  ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_owned_finite_songs BEGIN SPCL751A => song_enemy_projectile END
END
ACTION_IF FILE_EXISTS_IN_GAME ~C0BDD#SO.SPL~ BEGIN
  ADD_PROJECTILE ~%MOD_FOLDER%/darkbloom/c0bdd#so.PRO~ ~Bard Song Ignore Caster~
  COPY ~%MOD_FOLDER%/darkbloom/c0bdd#so.PRO~ ~override~
  OUTER_SET darkbloom_projectile = IDS_OF_SYMBOL (~PROJECTL~ ~C0BDD#SO~) + 1
  ACTION_DEFINE_ASSOCIATIVE_ARRAY c0bw_owned_finite_songs BEGIN C0BDD#SO => darkbloom_projectile END
END

ACTION_PHP_EACH c0bw_owned_finite_songs AS song => profile BEGIN
  OUTER_SET $c0bw_owned_songs(~%song%~) = 1
END
OUTER_SET $c0bw_owned_songs(C0ABETS2) = 1
LAF c0bw_find_external_songs RET_ARRAY c0bw_eligible_songs c0bw_damaged_resources END

ACTION_IF c0bw_song_loader_ready BEGIN
  ACTION_PHP_EACH c0bw_owned_finite_songs AS song => profile BEGIN
    LAF c0bw_wrap_song INT_VAR payload_projectile = EVAL ~%profile%~
      STR_VAR bardsong_name = EVAL ~%song%~
      RET_ARRAY c0bw_damaged_resources
    END
  END
  LAF c0bw_wrap_song INT_VAR payload_projectile = song_party_projectile STR_VAR bardsong_name = ~C0ABETS2~
    RET symphony_payload = song_name
    RET_ARRAY c0bw_damaged_resources
  END
  INCLUDE ~%MOD_FOLDER%/lib/abettor_hla_finite.tpa~
  LAF c0bw_wrap_external_songs RET_ARRAY c0bw_damaged_resources END
END
ACTION_PHP_EACH c0bw_damaged_resources AS damaged_file => reason BEGIN
  ACTION_IF reason = 2 BEGIN
    PRINT ~Bardic Wonders #2004: skipping %damaged_file% at the 65535-effect capacity limit.~
  END ELSE BEGIN
    PRINT ~Bardic Wonders #2004: skipping damaged %damaged_file%.~
  END
END
INCLUDE ~%MOD_FOLDER%/lib/bardsong_description.tpa~
ACTION_IF c0bw_song_loader_ready BEGIN
  // Companion options can run in a later WeiDU process. WeiDU owns and
  // uninstalls this marker with the finite-song component.
  <<<<<<<< .../inlined/c0bw-song-state.2da
2DA V1.0
0
      FINITE
STATE 1
>>>>>>>>
  COPY ~.../inlined/c0bw-song-state.2da~ ~override/C0BWSYS.2DA~
  LAF c0bw_write_song_description END
END

COPY_EXISTING ~enginest.2da~ ~override~
  COUNT_2DA_ROWS 2 rows
  FOR (row = 0 ; row < rows ; ++row) BEGIN
    READ_2DA_ENTRY row 0 2 entry
    PATCH_IF (("%entry%" STRING_COMPARE_CASE "STRREF_FEEDBACK_BATTLESONGBEGIN"      = 0) OR
              ("%entry%" STRING_COMPARE_CASE "STRREF_FEEDBACK_BATTLESONGEND"   		= 0)) BEGIN
      FOR (col = 1; col < 2 ; ++col) BEGIN
        SET_2DA_ENTRY row col 2 0
      END
    END
  END
  PRETTY_PRINT_2DA
  BUT_ONLY
  
COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~ //copies all spell files
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 200 parameter1 = 110 END
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 300 parameter1 = 120 END
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 400 parameter1 = 130 END
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 500 parameter1 = 140 END
LPF ALTER_EFFECT INT_VAR silent = 1 match_opcode = 99 match_parameter2 = 2 match_parameter1 = 600 parameter1 = 150 END
BUT_ONLY

COPY_EXISTING_REGEXP GLOB ~^.+\.bcs~ ~override~ //Parse through all dlg files
                DECOMPILE_AND_PATCH BEGIN
                    REPLACE_TEXTUALLY ~!ModalState(BATTLESONG)~ ~!CheckSpellState(Myself,BARD_SONG)~ //Replace trigger respecting OR and !
                END
                DECOMPILE_AND_PATCH BEGIN
                    //Recommended by refactor trigger to fix whitespace
                END

        BUT_ONLY
