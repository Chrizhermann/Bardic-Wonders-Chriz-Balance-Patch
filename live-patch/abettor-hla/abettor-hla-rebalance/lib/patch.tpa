  PATCH_IF (BUFFER_LENGTH >= 0x110) BEGIN
    LPF C0_VALIDATE_ABETTOR_EFF_RESERVED_FIELDS RET reserved_fields_valid = valid END
    READ_ASCII 0 signature (8)
    READ_ASCII 0x08 secondary_signature (8)
    READ_LONG 0x10 opcode
    READ_LONG 0x14 target
    READ_LONG 0x18 power
    READ_LONG 0x1c parameter1
    READ_LONG 0x20 parameter2
    READ_LONG 0x24 timing
    READ_LONG 0x28 duration
    READ_SHORT 0x2c probability1
    READ_SHORT 0x2e probability2
    READ_ASCII 0x30 payload (8) NULL
    SET payload_length = STRING_LENGTH ~%payload%~
    SET payload_padding_valid = 1
    FOR (payload_index = payload_length; payload_index < 8; ++payload_index) BEGIN
      READ_BYTE (0x30 + payload_index) payload_padding_byte
      PATCH_IF (payload_padding_byte != 0) BEGIN
        SET payload_padding_valid = 0
      END
    END
    PATCH_IF
      (~%signature%~ STRING_EQUAL_CASE ~EFF V2.0~)
      AND (~%secondary_signature%~ STRING_EQUAL_CASE ~EFF V2.0~)
      AND (opcode = 146)
      AND (target = 1)
      AND (power = 0)
      AND (parameter1 = 0)
      AND (parameter2 = 1)
      AND (timing = 1)
      AND (duration = 0)
      AND (probability1 = 100)
      AND (probability2 = 0)
      AND ((STRING_LENGTH ~%payload%~) > 0)
      AND (~%payload%~ STRING_MATCHES_REGEXP ~^[A-Za-z0-9_#@-][A-Za-z0-9_#@-]*$~ = 0)
      AND !(~%payload%~ STRING_EQUAL_CASE ~C0ABIVI~)
      AND !(~%payload%~ STRING_EQUAL_CASE ~C0ABIVS~)
      AND !(~%payload%~ STRING_EQUAL_CASE ~C0ABIVE~)
      AND (payload_padding_valid = 1)
      AND (reserved_fields_valid = 1)
    BEGIN
      INNER_ACTION BEGIN
        OUTER_TEXT_SPRINT c0_abettor_payload ~%payload%~
        OUTER_SET c0_abettor_pointer_valid = 1
      END
    END
  END
